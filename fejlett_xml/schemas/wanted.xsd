<?xml version="1.0" encoding="UTF-8"?>
<xs:schema
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    targetNamespace="http://example.com/wanted"
    xmlns="http://example.com/wanted"
    elementFormDefault="qualified">
    
    <xs:element name="wantedPersons">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="wantedPerson" maxOccurs="unbounded">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="title" type="xs:string"/>
                            <xs:element name="status" type="xs:string"/>
                            <xs:element name="subjects" type="xs:string" minOccurs="0"/>
                            <xs:element name="url" type="xs:anyURI"/>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    
</xs:schema>
